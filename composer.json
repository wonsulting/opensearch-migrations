{
    "name": "wonsulting/opensearch-migrations",
    "description": "OpenSearch migrations for Laravel",
    "keywords": [
        "laravel",
        "migrations",
        "opensearch",
        "php"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ivan Babenko",
            "email": "babenko.i.a@gmail.com"
        },
        {
            "name": "Friends of CAT"
        },
        {
            "name": "Wonsulting",
            "homepage": "https://wonsulting.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "OpenSearch\\Migrations\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSearch\\Migrations\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "wonsulting/opensearch-adapter": "^2.0 || ^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.14 || ^10.6 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenSearch\\Migrations\\ServiceProvider"
            ]
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-mdq4-51ck-6kdq": "No patched Laravel 11.x release exists; this package does not use Laravel's email validation rule, so the CRLF injection is not reachable here.",
                    "PKSA-3r5d-mb8f-1qw9": "Only affects the same unreachable email validation rule; kept unblocked so Laravel 11.x test dependencies can still resolve.",
                    "PKSA-m5cs-t1y6-qpcs": "Signed URL path confusion is not exercised by this package or its test suite."
                }
            }
        }
    },
    "scripts": {
        "check-style": "./vendor/bin/php-cs-fixer fix --allow-risky=yes --dry-run --diff --show-progress=dots --verbose",
        "fix-style": "./vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "./vendor/bin/phpunit --testdox",
        "test-coverage": "./vendor/bin/phpunit --testdox --coverage-text"
    }
}
